{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "作業時間記録",
  "version": "0.1.0",
  "identifier": "com.masam.work-time-tracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "作業時間記録",
        "width": 500,
        "height": 700,
        "resizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "globalShortcut": {
      "shortcuts": [
        {
          "shortcut": "Ctrl+Shift+S",
          "kind": "stopTask"
        },
        {
          "shortcut": "Ctrl+Shift+R",
          "kind": "restartTask"
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  }
}
